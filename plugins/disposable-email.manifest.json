{
  "identifier": "run.vineyard.pluginpacks.disposable_email",
  "content_type": "vineyard:pluginpack",
  "name": "Disposable Email",
  "version": "1.0.0",
  "description": "Checks whether the selected email address belongs to a known disposable-email domain (74k+ domain blocklist, subdomain-aware), and sets the node's is_disposable flag to true or false.",
  "author": {
    "name": "VINEYARD",
    "url": "https://vineyard.run"
  },
  "license": "Apache-2.0",
  "icon": "mail-x",
  "platforms": {
    "primary": "web",
    "web": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs"
    },
    "desktop": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs",
      "min_app_version": "0.1.0"
    }
  },
  "distribution": {
    "kind": "git",
    "repository": "https://github.com/Vineyard-Intelligence/pluginpack-disposable-email",
    "ref": "v1.0.0",
    "path": "plugins/disposable-email.manifest.json"
  },
  "plugins": [
    {
      "identifier": "run.vineyard.plugins.disposable_email",
      "content_type": "vineyard:plugin",
      "name": "Disposable Email Check",
      "version": "1.0.0",
      "description": "Checks whether the selected email address belongs to a known disposable-email domain (74k+ domain blocklist, subdomain-aware), and sets the node's is_disposable flag to true or false.",
      "icon": "mail-x",
      "platforms": {
        "primary": "web",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        },
        "desktop": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs",
          "min_app_version": "0.1.0"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.identity",
            "category": "identity",
            "name": "email_address"
          }
        ],
        "produces": []
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:update"
        ],
        "network": [
          {
            "endpoint": "https://cdn.jsdelivr.net/gh/disposable/disposable-email-domains@master/domains.json",
            "methods": [
              "GET"
            ],
            "purpose": "Fetch the disposable-email-domains blocklist (CDN, CORS-enabled)."
          }
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    }
  ]
}
